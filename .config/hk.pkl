amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

// To override this, create a ".config/hk.local.pkl" file.
// See: https://hk.jdx.dev/configuration.html#hk-local-pkl.
local linters = new Mapping {
    ["prettier"] = Builtins.prettier
    ["eslint"] = Builtins.eslint
    ["publint"] = new Step {
        glob = "package.json"
        // Does not include suggestion (info) messages.
        check = "publint --level warning --strict"
    }
    ["tsc"] = Builtins.tsc
}

steps = linters
